{
  "name": "public-domain-cartoon-fighters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "art": "node scripts/build-cels.mjs",
    "audio": "node scripts/build-audio.mjs",
    "balance": "node scripts/simulate-matchups.mjs",
    "dev": "node server.mjs",
